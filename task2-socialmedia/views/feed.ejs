<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>CodeAlpha Social</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <!-- ========================= -->
    <!-- NAVIGATION -->
    <!-- ========================= -->

    <nav class="navbar">

        <div class="logo">
            🌐 CodeAlpha Social
        </div>

        <div class="nav-links">

            <a href="/">
                🏠 Home
            </a>

            <a href="/profile/<%= user.username %>">
                👤 <%= user.username %>
            </a>

            <a href="/logout">
                🚪 Logout
            </a>

        </div>

    </nav>


    <!-- ========================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================= -->

    <main class="feed-container">

        <!-- Welcome -->

        <section class="welcome">

            <h1>
                Welcome, <%= user.name %>! 👋
            </h1>

            <p>
                Share something with the community.
            </p>

        </section>


        <!-- ========================= -->
        <!-- CREATE POST -->
        <!-- ========================= -->

        <section class="create-post">

            <h2>Create a Post</h2>

            <form
                action="/posts"
                method="POST"
            >

                <textarea
                    name="content"
                    placeholder="What's on your mind?"
                    rows="4"
                    required
                ></textarea>

                <button type="submit">
                    📝 Post
                </button>

            </form>

        </section>


        <!-- ========================= -->
        <!-- POSTS -->
        <!-- ========================= -->

        <section class="posts-section">

            <h2>Latest Posts</h2>

            <% if (posts.length === 0) { %>

                <div class="no-posts">

                    <p>
                        No posts yet.
                    </p>

                    <p>
                        Be the first person to create a post!
                    </p>

                </div>

            <% } %>


            <% posts.forEach(post => { %>

                <article class="post-card">

                    <!-- Post Header -->

                    <div class="post-header">

                        <div>

                            <a
                                href="/profile/<%= post.username %>"
                                class="username"
                            >
                                @<%= post.username %>
                            </a>

                            <p class="post-author">
                                <%= post.name %>
                            </p>

                        </div>

                        <small>
                            <%= post.created_at %>
                        </small>

                    </div>


                    <!-- Post Content -->

                    <div class="post-content">

                        <p>
                            <%= post.content %>
                        </p>

                    </div>


                    <!-- Post Actions -->

                    <div class="post-actions">

                        <!-- Like -->

                        <form
                            action="/posts/<%= post.id %>/like"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="like-button"
                            >

                                <% if (post.liked) { %>

                                    ❤️ Unlike

                                <% } else { %>

                                    🤍 Like

                                <% } %>

                                (<%= post.like_count %>)

                            </button>

                        </form>


                        <!-- Comments count -->

                        <span class="comment-count">

                            💬
                            <%= post.comment_count %>
                            Comments

                        </span>


                        <!-- Delete own post -->

                        <% if (post.user_id === user.id) { %>

                            <form
                                action="/posts/delete/<%= post.id %>"
                                method="POST"
                            >

                                <button
                                    type="submit"
                                    class="delete-button"
                                >
                                    🗑️ Delete
                                </button>

                            </form>

                        <% } %>

                    </div>


                    <!-- ========================= -->
                    <!-- ADD COMMENT -->
                    <!-- ========================= -->

                    <div class="comment-form">

                        <form
                            action="/posts/<%= post.id %>/comments"
                            method="POST"
                        >

                            <input
                                type="text"
                                name="content"
                                placeholder="Write a comment..."
                                required
                            >

                            <button type="submit">
                                Comment
                            </button>

                        </form>

                    </div>

                </article>

            <% }); %>

        </section>

    </main>


    <!-- ========================= -->
    <!-- FOOTER -->
    <!-- ========================= -->

    <footer>

        <p>
            © 2026 CodeAlpha Social Media Platform
        </p>

    </footer>

</body>

</html>