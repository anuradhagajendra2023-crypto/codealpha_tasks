<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= task.title %> - CodeAlpha Projects</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar">

        <div class="logo">
            📋 CodeAlpha Projects
        </div>

        <div class="nav-links">

            <a href="/dashboard">
                🏠 Dashboard
            </a>

            <a href="/projects/<%= project.id %>">
                📁 Back to Project
            </a>

            <a href="/logout">
                🚪 Logout
            </a>

        </div>

    </nav>


    <!-- Main -->
    <main class="container">

        <!-- Task Details -->
        <div class="task-detail-card">

            <div class="task-header">

                <div>

                    <h1>
                        📝 <%= task.title %>
                    </h1>

                    <span class="status-badge">
                        <%= task.status %>
                    </span>

                </div>

            </div>


            <div class="task-description">

                <h3>
                    Description
                </h3>

                <p>
                    <%= task.description || "No description provided." %>
                </p>

            </div>


            <div class="task-info">

                <p>

                    <strong>
                        Assigned To:
                    </strong>

                    <% if (task.assigned_name) { %>

                        <%= task.assigned_name %>

                    <% } else { %>

                        Unassigned

                    <% } %>

                </p>


                <p>

                    <strong>
                        Status:
                    </strong>

                    <%= task.status %>

                </p>

            </div>

        </div>


        <!-- Comments -->
        <section class="comments-section">

            <h2>
                💬 Task Comments
            </h2>


            <% if (comments.length === 0) { %>

                <div class="empty-card">

                    <p>
                        No comments yet.
                    </p>

                    <p>
                        Be the first person to comment!
                    </p>

                </div>

            <% } else { %>

                <div class="comments-list">

                    <% comments.forEach(comment => { %>

                        <div class="comment-card">

                            <div class="comment-header">

                                <strong>
                                    <%= comment.name %>
                                </strong>

                                <span>
                                    @<%= comment.username %>
                                </span>

                            </div>


                            <p>
                                <%= comment.comment %>
                            </p>


                            <small>
                                <%= comment.created_at %>
                            </small>

                        </div>

                    <% }); %>

                </div>

            <% } %>


            <!-- Add Comment -->

            <div class="comment-form">

                <h3>
                    Add a Comment
                </h3>

                <form
                    action="/tasks/<%= task.id %>/comments"
                    method="POST"
                >

                    <textarea
                        name="comment"
                        rows="4"
                        placeholder="Write your comment..."
                        required
                    ></textarea>


                    <button
                        type="submit"
                        class="button"
                    >
                        💬 Add Comment
                    </button>

                </form>

            </div>

        </section>


        <!-- Delete Task -->

        <div class="delete-section">

            <form
                action="/tasks/<%= task.id %>/delete"
                method="POST"
                onsubmit="return confirm('Are you sure you want to delete this task?');"
            >

                <button
                    type="submit"
                    class="delete-button"
                >
                    🗑️ Delete Task
                </button>

            </form>

        </div>

    </main>


    <!-- Footer -->
    <footer>

        <p>
            © 2026 CodeAlpha Project Management
        </p>

    </footer>

</body>
</html>